{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Entra-specific settings, required for 'entra-delegated' authorizer.
  "Entra": {
    "TenantId": null,
    "WorkforceIdentityProviderName": null,
    "Scopes": null
  },

  // Generic IdP settings, required for 'delegated' authorizer.
  "Idp": {
    "Issuer": null,
    "WorkforceIdentityProviderName": null,
    "Scopes": null
  },

  "DefaultAuthorizer": "google-identity",

  "AuthorizedRedirectUris": [
    //
    // URLs used by Gemini Enterprise
    // https://docs.cloud.google.com/gemini/enterprise/docs/register-and-manage-an-a2a-agent#obtain_authorization_details
    //
    "https://vertexaisearch.cloud.google.com/oauth-redirect",
    "https://vertexaisearch.cloud.google.com/static/oauth/oauth.html"
  ]
}
